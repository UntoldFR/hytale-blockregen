$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 860, Height: 660);

    #Title {
      $C.@Title {
        @Text = "BlockRegen - Configured Blocks";
      }
    }

    #Content {
      LayoutMode: Top;

      // Scope selector: "Global" or a CustomAreas area flagged BLOCKREGEN.
      // Always has at least a "Global" entry - if CustomAreas isn't
      // installed this just behaves as a single-choice dropdown, and the
      // rest of the page is unaffected. #IndependentToggle is injected
      // dynamically (like #AddUnitToggle below) only when an area is
      // selected.
      Group #ScopeSection {
        LayoutMode: Left;
        Anchor: (Bottom: 8, Height: 40);
        Background: (Color: #000000(0.15));
        Padding: (Full: 8);

        $C.@DropdownBox #ScopeDropdown {
          @Anchor = (Right: 8);
        }

        Group #IndependentToggle {
          LayoutMode: Left;
          Anchor: (Right: 8);
        }
      }

      // Add a new rule by picking any block (vanilla or modded) from a
      // searchable dropdown instead of having to target it in-game.
      Group #AddSection {
        LayoutMode: Left;
        Anchor: (Bottom: 12, Height: 54);
        Background: (Color: #000000(0.15));
        Padding: (Full: 8);

        $C.@DropdownBox #AddBlock {
          @Anchor = (Right: 8);
          ShowSearchInput: true;
          TooltipText: "Pick any block (vanilla or from a mod) to add a new rule for";
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        }

        $C.@NumberField #AddDelay {
          @Anchor = (Width: 70, Right: 6);
          Format: (MaxDecimalPlaces: 0, Step: 1);
          TooltipText: "Delay before the picked block regenerates";
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        }

        Group #AddUnitToggle {
          LayoutMode: Left;
          Anchor: (Right: 8);
        }

        $C.@NumberField #AddRadius {
          @Anchor = (Width: 55, Right: 6);
          Format: (MaxDecimalPlaces: 0, Step: 1);
          TooltipText: "Scatter radius in blocks around the break point (0 = exact spot)";
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        }

        // Single ON/OFF "need floor" toggle button, injected dynamically by
        // BlockRegenListPage (same mechanism as #AddUnitToggle above).
        Group #AddFloorToggle {
          LayoutMode: Left;
          Anchor: (Right: 8);
        }

        $C.@SmallSecondaryTextButton #AddButton {
          @Text = "ADD";
          @Anchor = (Width: 80);
          Padding: (Horizontal: 8);
          TooltipText: "Add a regeneration rule for the picked block";
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        }
      }

      Group #BlockList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }
  }
}

$C.@BackButton {}
